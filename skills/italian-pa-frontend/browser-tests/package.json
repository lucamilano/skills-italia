{
  "name": "italian-pa-frontend-browser-tests",
  "version": "0.6.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "Optional technology-neutral browser acceptance and automated accessibility checks",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "validate": "node --test scripts/*.test.mjs",
    "review": "node scripts/review.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.56.0"
  }
}
